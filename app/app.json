{
  "expo": {
    "name": "DroidUI",
    "slug": "droidui",
    "version": "7.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.codephrex.droidstudio"
    },
    "splash": {
      "backgroundColor": "#080D1F"
    },
    "plugins": [
      "./plugins/withAndroidSplashBackground"
    ]
  }
}
